{
  "name": "folilune-studio-autonomous-stage1a",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "description": "Local-only autonomous prose production experiment; publishing is disabled",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "node engine/server.mjs",
    "test:autonomous": "node --test",
    "simulate": "node engine/cli.mjs run fixtures/brief.json --provider simulated",
    "simulate:auto": "node engine/auto-queue.mjs fixtures/autonomy-profile.json simulated",
    "test": "node --test",
    "test:integration": "python tests/server-integration.py && python tests/queue-integration.py",
    "test:queue": "python tests/queue-integration.py",
    "test:ui": "python tests/queue-ui-smoke.py"
  }
}
